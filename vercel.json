{
  "framework": null,
  "buildCommand": "mkdir -p public/js && cp shared/game-core.js public/js/game-core.js && echo \"window.SERVER_URL='${SERVER_URL}';window.SB_U='${SUPABASE_URL}';window.SB_A='${SUPABASE_ANON}';window.C_WA='${COMMUNITY_WA}';window.C_DC='${COMMUNITY_DC}';\" > public/js/config.js",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "map"
        }
      ],
      "destination": "/api/og"
    },
    {
      "source": "/controller",
      "destination": "/controller.html"
    },
    {
      "source": "/join",
      "destination": "/controller.html"
    },
    {
      "source": "/phone",
      "destination": "/controller.html"
    },
    {
      "source": "/replay",
      "destination": "/replay.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https: wss:; manifest-src 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/js/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}