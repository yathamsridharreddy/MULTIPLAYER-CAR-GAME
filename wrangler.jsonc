{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sridhar-rush-staging",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-17",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "GameServerContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GAME_SERVER", "class_name": "GameServerContainer" }
    ]
  },
  "exports": {
    "GameServerContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "CONTAINER_PORT": "3000",
    "CONTAINER_IDLE_MS": "600000",
    "LOW_BANDWIDTH": "0",
    "MEM_CAP": "150000",
    "AN_USER_CAP": "250000"
  }
}
